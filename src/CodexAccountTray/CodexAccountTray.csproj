<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Codex-Konten</AssemblyName>
    <RootNamespace>CodexAccountTray</RootNamespace>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <Product>Codex-Konten</Product>
    <Company>Andrin</Company>
    <Description>Lokale Verwaltung mehrerer Codex-Konten</Description>
    <ApplicationIcon>..\..\assets\Codex-Konten.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\Codex-Konten.ico"
                      Link="Assets\Codex-Konten.ico"
                      LogicalName="CodexAccountTray.AppIcon.ico" />
    <Content Include="..\..\tools\task-router\**\*"
             Exclude="..\..\tools\task-router\**\__pycache__\**;..\..\tools\task-router\**\*.pyc;..\..\tools\task-router\tests\**"
             Link="TaskRouter\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
